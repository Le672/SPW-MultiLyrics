{
  "configs": [
    {
      "title": "基本设置",
      "config": "multilyrics.json",
      "preferences": [
        {
          "key": "enabled",
          "type": "switch",
          "title": "启用在线歌词搜索",
          "summary": "关闭后插件不再返回任何歌词",
          "default_value": true
        },
        {
          "key": "priority_mode",
          "type": "switch",
          "title": "优先模式",
          "summary": "开启后在 SPW 默认歌词加载之前接管；关闭则作为兜底（默认逻辑找不到时才搜索）",
          "default_value": false
        },
        {
          "key": "show_toast",
          "type": "switch",
          "title": "显示加载提示",
          "summary": "加载成功时弹出 Toast 提示歌词来源",
          "default_value": false
        },
        {
          "key": "timeout_seconds",
          "type": "seekbar",
          "title": "单次搜索超时（秒）",
          "default_value": 8.0,
          "min": 3.0,
          "max": 20.0
        },
        {
          "type": "button",
          "title": "清除搜索缓存",
          "summary": "清除本次会话的内存搜索记忆，下次播放将重新联网搜索",
          "arrow_type": "none",
          "on_click": "com.spw.multilyrics.MultiLyricsPlugin.clearSearchCache"
        }
      ]
    },
    {
      "title": "歌词来源",
      "config": "multilyrics.json",
      "preferences": [
        {
          "key": "source.apple_music",
          "type": "switch",
          "title": "Apple Music (AMLL 逐字)",
          "summary": "基于 AMLL TTML DB 的 Apple Music 风格逐字歌词",
          "default_value": true
        },
        {
          "key": "source.qq",
          "type": "switch",
          "title": "QQ音乐",
          "summary": "QRC 逐字歌词，含翻译/罗马音",
          "default_value": true
        },
        {
          "key": "source.netease",
          "type": "switch",
          "title": "网易云音乐",
          "summary": "YRC 逐字歌词，含翻译/罗马音",
          "default_value": true
        },
        {
          "key": "source.kugou",
          "type": "switch",
          "title": "酷狗音乐",
          "summary": "KRC 逐字歌词，含翻译/罗马音",
          "default_value": true
        },
        {
          "key": "source.kuwo",
          "type": "switch",
          "title": "酷我音乐",
          "summary": "LRC 行级同步歌词",
          "default_value": true
        },
        {
          "key": "source.spotify",
          "type": "switch",
          "title": "Spotify (lrclib)",
          "summary": "通过 lrclib 聚合库获取 Spotify 元数据歌词",
          "default_value": true
        }
      ]
    },
    {
      "title": "副歌词",
      "config": "multilyrics.json",
      "preferences": [
        {
          "key": "translation",
          "type": "switch",
          "title": "显示翻译",
          "summary": "在主歌词下方附加翻译行（需 SPW 开启翻译显示）",
          "default_value": true
        },
        {
          "key": "romanization",
          "type": "switch",
          "title": "显示罗马音",
          "summary": "在主歌词下方附加罗马音行（无翻译时生效）",
          "default_value": false
        }
      ]
    }
  ]
}
